---
import '@styles/global.css';
import '@styles/post-card.css';
import ImageModule from './misc/ImageModule.astro';

import { getRelativeLocaleUrl } from '@utils/url-utils';
import { formatFullDate } from '@/utils/time';
import { hashString } from '@utils/hash';

interface Props {
  title: string;
  description: string;
  image: string;
  pubDate: Date;
  updatedDate?: Date;
  url: string;
  fallback: boolean;
  categories?: string[];
  preview?: string;
  readingMinutes?: number;
  revealDelay?: number;
  externalImage?: string;
  photographer?: string;
  photographerUrl?: string;
  pinned?: boolean;
}

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  url,
  fallback,
  categories = [],
  preview = description,
  readingMinutes = 1,
  revealDelay = 0,
  externalImage = '',
  photographer = '',
  photographerUrl = '',
  pinned = false,
} = Astro.props;

const currentLang = 'zh-cn';

const readingLabel = `${readingMinutes} 分钟阅读`;
const previewText = String(preview || description || '').trim();
const cardLabel = `阅读文章：${title}`;

// 本地封面优先，其次外部封面；两者都没有时只保留纯文字卡片
const coverSrc = image || externalImage || '';
const hasImage = Boolean(coverSrc);
// Stable tones keep the approved canvas without extra image analysis requests.
const coverTones = [
  { light: '#edf0df', dark: '#293c31' },
  { light: '#ece9df', dark: '#353b30' },
  { light: '#e6eee2', dark: '#263a31' },
  { light: '#eeeadf', dark: '#39382b' },
];
const coverTone = coverTones[hashString(url) % coverTones.length];

const pageUrl = getRelativeLocaleUrl(currentLang, '/blog/' + url);
---

<article
  data-card-reveal
  style={`--card-reveal-delay:${revealDelay}ms;--post-card-light:${coverTone.light};--post-card-dark:${coverTone.dark};`}
  class:list={['post-card', hasImage ? 'post-card--with-image' : 'post-card--no-image']}
>
  <a href={pageUrl} aria-label={cardLabel} class="post-card__stretched-link"></a>

  <div class:list={['post-card__cover', { 'post-card__cover--placeholder': !hasImage }]}>
    {hasImage && <ImageModule src={coverSrc} alt={title} class="post-card__image" />}
  </div>

  {
    !image &&
      externalImage &&
      photographer &&
      (photographerUrl ? (
        <a
          href={photographerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="post-card__photo-credit"
          title={`Photo by ${photographer}`}
        >
          {photographer}
        </a>
      ) : (
        <span class="post-card__photo-credit" title={`Photo by ${photographer}`}>
          {photographer}
        </span>
      ))
  }

  <div class="post-card__body">
    {
      (pinned || categories.length > 0) && (
        <div class="post-card__tags">
          {pinned && (
            <span class="post-card__pinned-badge">
              <span class="post-card__pinned-dot" />
              置顶
            </span>
          )}
          {categories.map((category) => (
            <span class="post-card__tag">{category}</span>
          ))}
        </div>
      )
    }

    <h2 class="post-card__title">
      {title}
      {fallback && <span class="post-card__lang">zh-cn</span>}
    </h2>
    <p class="post-card__summary">{previewText}</p>
    <div class="post-card__meta">
      <span>{formatFullDate(pubDate, currentLang)}</span>
      {
        updatedDate && updatedDate.valueOf() > pubDate.valueOf() && (
          <>
            <span class="post-card__meta-sep">•</span>
            <span>{`最后更新于 ${formatFullDate(updatedDate, currentLang)}`}</span>
          </>
        )
      }
      <span class="post-card__meta-sep">•</span>
      <span>{readingLabel}</span>
      <span class="post-card__direction" aria-hidden="true">↗</span>
    </div>
  </div>
</article>

<script>
  import { onPageScoped } from '@utils/page-lifecycle';

  onPageScoped((cleanup) => {
    document.querySelectorAll<HTMLImageElement>('.post-card__image').forEach((image) => {
      const card = image.closest<HTMLElement>('.post-card');
      if (!card) return;
      const syncImage = () => {
        card.classList.toggle('post-card--image-error', image.complete && image.naturalWidth === 0);
      };
      image.addEventListener('load', syncImage);
      image.addEventListener('error', syncImage);
      cleanup(() => {
        image.removeEventListener('load', syncImage);
        image.removeEventListener('error', syncImage);
      });
      syncImage();
    });
  });
</script>
